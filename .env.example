# Leo Academy — server configuration
#
# Every variable is optional. With none of them the app still works:
# it writes to a local LibSQL file and the browser keeps Dexie as primary store.
#
# Local SQLite/LibSQL file (development or a persistent server):
DATABASE_URL=file:local.db
# Remote Turso database (free tier) — replaces the file URL when present:
# DATABASE_URL=libsql://your-database.turso.io
# Required only for a remote Turso database:
DATABASE_AUTH_TOKEN=

# Classroom teacher PIN (4 digits). Defaults to 1006 when absent.
PROFESSOR_PIN=1006

# Recommended in production so cookies survive cold starts and instances.
# If omitted, signatures are derived deterministically from the PIN.
TEACHER_SESSION_SECRET=
STUDENT_SESSION_SECRET=

# Optional: override the folder that holds the Drizzle migrations.
# LEO_MIGRATIONS_DIR=./drizzle
